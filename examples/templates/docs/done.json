{
  "version": "1.0",
  "task_id": "docs-validation",
  "must_pass": [
    {
      "type": "file_exists",
      "name": "DoneSpec file exists",
      "path": "done.json"
    },
    {
      "type": "file_exists",
      "name": "README exists",
      "path": "README.md"
    },
    {
      "type": "regex_in_file",
      "name": "README has a title",
      "path": "README.md",
      "pattern": "^# ",
      "flags": [
        "MULTILINE"
      ]
    }
  ],
  "must_not": []
}
