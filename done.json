{
  "version": "1.0",
  "task_id": "donespec-self-validation",
  "must_pass": [
    {
      "type": "command",
      "name": "ruff lint passes",
      "run": "ruff check ."
    },
    {
      "type": "command",
      "name": "ruff format passes",
      "run": "ruff format --check ."
    },
    {
      "type": "command",
      "name": "pytest passes",
      "run": "pytest -q"
    },
    {
      "type": "file_exists",
      "name": "CLI entrypoint exists",
      "path": "src/donespec/cli.py"
    },
    {
      "type": "file_exists",
      "name": "GitHub Action exists",
      "path": "action.yml"
    },
    {
      "type": "file_exists",
      "name": "JSON schema exists",
      "path": "done.schema.json"
    },
    {
      "type": "regex_in_file",
      "name": "README contains core philosophy",
      "path": "README.md",
      "pattern": "Done means deterministically verified"
    },
    {
      "type": "regex_absent",
      "name": "No LLM dependencies in packaging",
      "path": "pyproject.toml",
      "pattern": "openai|anthropic|langchain|llama-index"
    },
    {
      "type": "file_exists",
      "name": "Agent instructions exist",
      "path": "AGENTS.md"
    },
    {
      "type": "regex_in_file",
      "name": "Agent instructions require DoneSpec validation",
      "path": "AGENTS.md",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "file_exists",
      "name": "VS Code tasks exist",
      "path": ".vscode/tasks.json"
    },
    {
      "type": "regex_in_file",
      "name": "VS Code task runs DoneSpec validation",
      "path": ".vscode/tasks.json",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "file_exists",
      "name": "Claude Code instructions exist",
      "path": "CLAUDE.md"
    },
    {
      "type": "regex_in_file",
      "name": "Claude imports shared agent protocol",
      "path": "CLAUDE.md",
      "pattern": "@AGENTS\\.md"
    },
    {
      "type": "regex_in_file",
      "name": "Claude instructions require DoneSpec validation",
      "path": "CLAUDE.md",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "regex_in_file",
      "name": "CI runs DoneSpec self-validation",
      "path": ".github/workflows/ci.yml",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "file_exists",
      "name": "Git pre-push hook exists",
      "path": ".githooks/pre-push"
    },
    {
      "type": "regex_in_file",
      "name": "Git pre-push hook runs DoneSpec",
      "path": ".githooks/pre-push",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "file_exists",
      "name": "Git hooks installer exists",
      "path": "scripts/install-git-hooks.ps1"
    },
    {
      "type": "regex_in_file",
      "name": "Git hooks installer configures hooks path",
      "path": "scripts/install-git-hooks.ps1",
      "pattern": "core\\.hooksPath"
    },
    {
      "type": "file_exists",
      "name": "Unix Git hooks installer exists",
      "path": "scripts/install-git-hooks.sh"
    },
    {
      "type": "regex_in_file",
      "name": "Unix Git hooks installer configures hooks path",
      "path": "scripts/install-git-hooks.sh",
      "pattern": "core\\.hooksPath"
    },
    {
      "type": "regex_in_file",
      "name": "Unix Git hooks installer references DoneSpec validation",
      "path": "scripts/install-git-hooks.sh",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "file_exists",
      "name": "Agent integration documentation exists",
      "path": "docs/agent-integration.md"
    },
    {
      "type": "regex_in_file",
      "name": "Agent integration docs mention Codex",
      "path": "docs/agent-integration.md",
      "pattern": "Codex"
    },
    {
      "type": "regex_in_file",
      "name": "Agent integration docs mention Claude Code",
      "path": "docs/agent-integration.md",
      "pattern": "Claude Code"
    },
    {
      "type": "regex_in_file",
      "name": "Agent integration docs require DoneSpec validation",
      "path": "docs/agent-integration.md",
      "pattern": "donespec validate done\\.json"
    },
    {
      "type": "regex_in_file",
      "name": "README links agent integration guide",
      "path": "README.md",
      "pattern": "docs/agent-integration\\.md"
    },
    {
      "type": "file_exists",
      "name": "Init project module exists",
      "path": "src/donespec/init_project.py"
    },
    {
      "type": "regex_in_file",
      "name": "CLI exposes init command",
      "path": "src/donespec/cli.py",
      "pattern": "@app\\.command\\(name=\"init\"\\)"
    },
    {
      "type": "file_exists",
      "name": "Init command tests exist",
      "path": "tests/test_init_project.py"
    },
    {
      "type": "regex_in_file",
      "name": "Init tests cover force overwrite",
      "path": "tests/test_init_project.py",
      "pattern": "--force"
    },
    {
      "type": "file_exists",
      "name": "Init documentation exists",
      "path": "docs/init.md"
    },
    {
      "type": "regex_in_file",
      "name": "Init docs explain donespec init",
      "path": "docs/init.md",
      "pattern": "donespec init"
    },
    {
      "type": "regex_in_file",
      "name": "Init docs mention force option",
      "path": "docs/init.md",
      "pattern": "--force"
    },
    {
      "type": "regex_in_file",
      "name": "README links init documentation",
      "path": "README.md",
      "pattern": "docs/init\\.md"
    },
    {
      "type": "file_exists",
      "name": "Doctor module exists",
      "path": "src/donespec/doctor.py"
    },
    {
      "type": "regex_in_file",
      "name": "CLI exposes doctor command",
      "path": "src/donespec/cli.py",
      "pattern": "@app\\.command\\(\\)"
    },
    {
      "type": "file_exists",
      "name": "Doctor command tests exist",
      "path": "tests/test_doctor.py"
    },
    {
      "type": "regex_in_file",
      "name": "Doctor supports JSON output",
      "path": "src/donespec/cli.py",
      "pattern": "report\\.to_dict"
    },
    {
      "type": "file_exists",
      "name": "Doctor documentation exists",
      "path": "docs/doctor.md"
    },
    {
      "type": "regex_in_file",
      "name": "Doctor docs explain donespec doctor",
      "path": "docs/doctor.md",
      "pattern": "donespec doctor"
    },
    {
      "type": "regex_in_file",
      "name": "Doctor docs mention JSON output",
      "path": "docs/doctor.md",
      "pattern": "donespec doctor --json"
    },
    {
      "type": "regex_in_file",
      "name": "README links doctor documentation",
      "path": "README.md",
      "pattern": "docs/doctor\\.md"
    },
    {
      "type": "regex_in_file",
      "name": "Init supports template option",
      "path": "src/donespec/cli.py",
      "pattern": "--template"
    },
    {
      "type": "regex_in_file",
      "name": "Template mode exists",
      "path": "src/donespec/init_project.py",
      "pattern": "class TemplateMode"
    },
    {
      "type": "regex_in_file",
      "name": "Python template exists",
      "path": "src/donespec/init_project.py",
      "pattern": "TemplateMode\\.python"
    },
    {
      "type": "regex_in_file",
      "name": "Node template exists",
      "path": "src/donespec/init_project.py",
      "pattern": "TemplateMode\\.node"
    },
    {
      "type": "regex_in_file",
      "name": "Docs template exists",
      "path": "src/donespec/init_project.py",
      "pattern": "TemplateMode\\.docs"
    },
    {
      "type": "regex_in_file",
      "name": "API template exists",
      "path": "src/donespec/init_project.py",
      "pattern": "TemplateMode\\.api"
    },
    {
      "type": "regex_in_file",
      "name": "CLI exposes templates command",
      "path": "src/donespec/cli.py",
      "pattern": "def templates"
    },
    {
      "type": "file_exists",
      "name": "Templates command tests exist",
      "path": "tests/test_templates_command.py"
    },
    {
      "type": "regex_in_file",
      "name": "Init tests cover python template",
      "path": "tests/test_init_project.py",
      "pattern": "--template"
    },
    {
      "type": "file_exists",
      "name": "Templates documentation exists",
      "path": "docs/templates.md"
    },
    {
      "type": "regex_in_file",
      "name": "Templates docs explain donespec templates",
      "path": "docs/templates.md",
      "pattern": "donespec templates"
    },
    {
      "type": "regex_in_file",
      "name": "Templates docs mention python template",
      "path": "docs/templates.md",
      "pattern": "donespec init --template python --yes"
    },
    {
      "type": "regex_in_file",
      "name": "README links templates documentation",
      "path": "README.md",
      "pattern": "docs/templates\\.md"
    },
    {
      "type": "file_exists",
      "name": "Generic template example exists",
      "path": "examples/templates/generic/done.json"
    },
    {
      "type": "file_exists",
      "name": "Python template example exists",
      "path": "examples/templates/python/done.json"
    },
    {
      "type": "file_exists",
      "name": "Node template example exists",
      "path": "examples/templates/node/done.json"
    },
    {
      "type": "file_exists",
      "name": "Docs template example exists",
      "path": "examples/templates/docs/done.json"
    },
    {
      "type": "file_exists",
      "name": "API template example exists",
      "path": "examples/templates/api/done.json"
    },
    {
      "type": "regex_in_file",
      "name": "Python template example includes pytest",
      "path": "examples/templates/python/done.json",
      "pattern": "pytest passes"
    },
    {
      "type": "regex_in_file",
      "name": "Node template example includes npm build",
      "path": "examples/templates/node/done.json",
      "pattern": "npm build passes"
    },
    {
      "type": "regex_in_file",
      "name": "API template example includes http check",
      "path": "examples/templates/api/done.json",
      "pattern": "http_check"
