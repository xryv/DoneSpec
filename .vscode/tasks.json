        "command": "${workspaceFolder}/.venv/bin/python -m pytest -q"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m pytest -q"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Lint",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m ruff check .",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff check ."
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff check ."
