          "env": {
            "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
            "VIRTUAL_ENV": "${workspaceFolder}/.venv"
          }
        }
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m donespec validate done.json --json",
        "options": {
          "env": {
            "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
            "VIRTUAL_ENV": "${workspaceFolder}/.venv"
          }
        }
      },
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}",
          "Path": "${workspaceFolder}\\.venv\\Scripts;${env:Path}",
          "VIRTUAL_ENV": "${workspaceFolder}\\.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Test",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q",
