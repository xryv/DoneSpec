{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DoneSpec: Validate",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m donespec validate done.json",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m donespec validate done.json"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m donespec validate done.json"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Validate JSON",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m donespec validate done.json --json",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m donespec validate done.json --json"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m donespec validate done.json --json"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Test",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m pytest -q"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m pytest -q"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Lint",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m ruff check .",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff check ."
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff check ."
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DoneSpec: Format Check",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m ruff format --check .",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff format --check ."
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m ruff format --check ."
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
