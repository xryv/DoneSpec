{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donespec.dev/schemas/done.schema.json",
  "title": "DoneSpec task validation spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "description": {
      "type": "string"
    },
    "must_pass": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" },
      "default": []
    },
    "must_not": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" },
      "default": []
    }
  },
  "anyOf": [
    { "required": ["must_pass"] },
    { "required": ["must_not"] }
  ],
  "$defs": {
    "check": {
      "oneOf": [
        { "$ref": "#/$defs/command" },
        { "$ref": "#/$defs/file_exists" },
        { "$ref": "#/$defs/regex_in_file" },
        { "$ref": "#/$defs/regex_absent" },
        { "$ref": "#/$defs/file_not_modified" },
        { "$ref": "#/$defs/http_check" }
      ]
    },
    "base_check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "run"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "command" },
            "run": { "type": "string", "minLength": 1 },
            "expected_exit_code": { "type": "integer", "default": 0 },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 120 }
          }
        }
      ]
    },
    "file_exists": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "file_exists" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "regex_in_file": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "pattern"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "regex_in_file" },
            "path": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "flags": {
              "type": "array",
              "items": {
                "enum": ["IGNORECASE", "MULTILINE", "DOTALL"]
              },
              "default": []
            }
          }
        }
      ]
    },
    "regex_absent": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "pattern"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "regex_absent" },
            "path": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "flags": {
              "type": "array",
              "items": {
                "enum": ["IGNORECASE", "MULTILINE", "DOTALL"]
              },
              "default": []
            }
          }
        }
      ]
    },
    "file_not_modified": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "file_not_modified" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "http_check": {
      "allOf": [
        { "$ref": "#/$defs/base_check" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "const": "http_check" },
            "url": { "type": "string", "format": "uri", "minLength": 1 },
            "method": {
              "type": "string",
              "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
              "default": "GET"
            },
            "expected_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599,
              "default": 200
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 10
            },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "default": {}
            }
          }
        }
      ]
    }
  }
}
